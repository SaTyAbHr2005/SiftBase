{
  "name": "siftbase-desktop",
  "productName": "SiftBase",
  "version": "0.1.0",
  "private": true,
  "description": "SiftBase desktop app: index a folder, ask it questions, see which pages answered.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "build:backend": "python scripts/build_backend.py",
    "dist": "electron-builder --win nsis",
    "icon": "python scripts/make_icon.py"
  },
  "dependencies": {
    "gsap": "3.15.1",
    "lenis": "1.3.27",
    "three": "0.187.0"
  },
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.siftbase.desktop",
    "productName": "SiftBase",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "renderer/**",
      "package.json",
      "resources/icon.png"
    ],
    "extraResources": [
      {
        "from": "build/backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/__pycache__/**"
        ]
      }
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "SiftBase-Setup-${version}.exe",
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico"
    }
  }
}
